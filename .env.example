# Copy this file to .env and fill in real values. Never commit .env.
#
# Note: the current AI teacher (ai-teacher/index.html) is a plain browser page and
# does NOT read this file yet. Keys are pasted into its Settings dialog and kept in
# that browser's localStorage. These variables are for the upcoming server, which
# should hold the keys so they never reach students' browsers.

# Claude (AI teacher brain) - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ElevenLabs (AI teacher voice) - https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
